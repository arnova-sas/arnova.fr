{
    "name": "arnova.fr",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check src",
        "lint:fix": "biome check --write src",
        "typecheck": "tsc --noEmit",
        "prettier": "prettier --write \"**/*.{css,md,yaml,yml}\"",
        "prettier:check": "prettier --check \"**/*.{css,md,yaml,yml}\"",
        "check:messages": "node scripts/check-messages.mjs",
        "check:contrast": "node scripts/check-contrast.mjs",
        "lint-ci": "yarn lint && yarn typecheck && yarn check:messages && yarn check:contrast",
        "prepare": "husky"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "next": "16.3.5",
        "next-intl": "^4.14.5",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.0",
        "prettier": "^3.8.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{css,md,yaml,yml}": "prettier --write"
    },
    "packageManager": "yarn@1.22.22"
}
